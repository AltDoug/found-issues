#!/usr/bin/env bash
# Mock gh CLI for bats tests.
#
# Reads mock responses from env vars:
#   GH_MOCK_PR_VIEW       tab-separated: <pr_num>\t<json>   (newline-separated rows)
#   GH_MOCK_PR_FILES      tab-separated: <pr_num>\t<paths>  for the paginated REST
#                         `gh api ... repos/{owner}/{repo}/pulls/<N>/files` call;
#                         paths are pre-filtered (literal \n between them). No
#                         matching row = the call fails (exit 1), which is how a
#                         test drives the `gh pr view` fallback.
#   GH_MOCK_PR_DIFF       mocked unified diff for `gh pr diff <N>`. Literal \n
#                         sequences are expanded (same convention as GH_MOCK_PR_VIEW rows).
#   GH_MOCK_REPO_VIEW     full JSON response for `gh repo view --json ...`
#   GH_MOCK_PR_LIST       full JSON array for `gh pr list --json ...` (default "[]")
#   GH_MOCK_AUTH          "ok" (default) or "fail" — controls `gh auth status` exit
#   GH_MOCK_TRACE         path to write each invocation (for assertions)
#   GH_MOCK_PR_CREATE_URL URL printed by `gh pr create` (default https://github.com/foo/bar/pull/7)
#   GH_MOCK_PR_BODY_COPY  path `gh pr create` copies its --body-file to (for assertions)
#   GH_MOCK_PR_MERGE      "ok" (default) or "fail" — exit of `gh pr merge`
#
# Behavior: print matching JSON to stdout and exit 0; exit 1 if no match.
# `pr view --jq <filter>` IS honored when the mocked row is JSON (sync asks gh
# for a pre-joined answer since v2.10.2, audit ledger-7): the row is run
# through real jq. A non-JSON row (a pre-filtered list) passes through as-is.
#
# Limitations (intentional):
#   - Only space-separated --flag value form is recognized; --flag=value
#     is NOT stripped from argv (no callers in this repo use the equals form).
#   - Rows that are NOT JSON skip the --jq filter — tests may still populate
#     GH_MOCK_PR_VIEW with already-filtered output for such calls.
#     (`bin/found-issues:cmd_annotate_pr` does this for `.files[].path`.)

set -euo pipefail

# Trace invocation if requested
if [[ -n "${GH_MOCK_TRACE:-}" ]]; then
  printf '%s\n' "$*" >> "$GH_MOCK_TRACE"
fi

# Strip --json fields and --jq from argv, remembering the --jq filter
filtered_args=()
jq_filter=""
skip_next=""
for a in "$@"; do
  if [[ -n "$skip_next" ]]; then
    [[ "$skip_next" == "jq" ]] && jq_filter="$a"
    skip_next=""
    continue
  fi
  case "$a" in
    --json) skip_next=json ;;
    --jq) skip_next=jq ;;
    *) filtered_args+=("$a") ;;
  esac
done

cmd="${filtered_args[0]:-}"
sub="${filtered_args[1]:-}"

case "$cmd $sub" in
  "api "*)
    endpoint=""
    for ((i = 1; i < ${#filtered_args[@]}; i++)); do
      case "${filtered_args[$i]}" in --*) ;; *) endpoint="${filtered_args[$i]}" ;; esac
    done
    if [[ "$endpoint" =~ /pulls/([0-9]+)/files ]] && [[ -n "${GH_MOCK_PR_FILES:-}" ]]; then
      api_pr="${BASH_REMATCH[1]}"
      while IFS=$'\t' read -r mock_num mock_files; do
        if [[ "$mock_num" == "$api_pr" ]]; then
          printf '%s\n' "${mock_files//\\n/$'\n'}"
          exit 0
        fi
      done <<<"$GH_MOCK_PR_FILES"
    fi
    printf 'gh: Not Found (HTTP 404)\n' >&2
    exit 1
    ;;
  "pr view")
    pr_num="${filtered_args[2]:-}"
    if [[ -n "${GH_MOCK_PR_VIEW:-}" ]]; then
      while IFS=$'\t' read -r mock_num mock_json; do
        [[ -z "$mock_num" ]] && continue
        if [[ "$mock_num" == "$pr_num" ]]; then
          # Expand literal \n sequences so one row can mock multi-line output
          # (the pre-filtered .files[].path list for multi-file PRs). Row
          # parsing above stays one-row-per-line.
          out="${mock_json//\\n/$'\n'}"
          if [[ -n "$jq_filter" ]] && printf '%s' "$out" | jq -e . >/dev/null 2>&1; then
            printf '%s' "$out" | jq -r "$jq_filter"
          else
            printf '%s\n' "$out"
          fi
          exit 0
        fi
      done <<<"$GH_MOCK_PR_VIEW"
    fi
    printf 'GraphQL: Could not resolve PR\n' >&2
    exit 1
    ;;
  "pr list")
    # Mocked PR list. Reads GH_MOCK_PR_LIST (full JSON array, e.g. "[]" or
    # '[{"number":1,"state":"OPEN"}]'). Defaults to "[]" (empty list, valid JSON).
    if [[ -n "$jq_filter" ]]; then
      printf '%s' "${GH_MOCK_PR_LIST:-[]}" | jq -r "$jq_filter"
    elif [[ -n "${GH_MOCK_PR_LIST:-}" ]]; then
      printf '%s\n' "$GH_MOCK_PR_LIST"
    else
      printf '[]\n'
    fi
    exit 0
    ;;
  "repo view")
    if [[ -n "${GH_MOCK_REPO_VIEW:-}" ]]; then
      if [[ -n "$jq_filter" ]]; then
        printf '%s' "$GH_MOCK_REPO_VIEW" | jq -r "$jq_filter"
      else
        printf '%s\n' "$GH_MOCK_REPO_VIEW"
      fi
      exit 0
    fi
    exit 1
    ;;
  "pr diff")
    # Mocked unified diff for `gh pr diff <N>`. Reads GH_MOCK_PR_DIFF with
    # literal \n expanded (same convention as GH_MOCK_PR_VIEW rows).
    if [[ -n "${GH_MOCK_PR_DIFF:-}" ]]; then
      printf '%s\n' "${GH_MOCK_PR_DIFF//\\n/$'\n'}"
      exit 0
    fi
    exit 1
    ;;
  "pr create")
    if [[ -n "${GH_MOCK_PR_BODY_COPY:-}" ]]; then
      prev=""
      for a in "$@"; do
        [[ "$prev" == "--body-file" ]] && cp "$a" "$GH_MOCK_PR_BODY_COPY"
        prev="$a"
      done
    fi
    printf '%s\n' "${GH_MOCK_PR_CREATE_URL:-https://github.com/foo/bar/pull/7}"
    exit 0
    ;;
  "pr merge")
    [[ "${GH_MOCK_PR_MERGE:-ok}" == "ok" ]] && exit 0
    printf 'auto-merge is not allowed for this repository\n' >&2
    exit 1
    ;;
  "auth status")
    if [[ "${GH_MOCK_AUTH:-ok}" == "ok" ]]; then
      printf 'Logged in to github.com\n'
      exit 0
    fi
    printf 'not authenticated\n' >&2
    exit 1
    ;;
  *)
    printf 'gh-shim: unsupported command: %s %s\n' "$cmd" "$sub" >&2
    exit 1
    ;;
esac
