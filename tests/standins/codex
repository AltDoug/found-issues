#!/usr/bin/env bash
# Stand-in `codex` (exec only) for the v3 auto-fix tests. Same FI_STANDIN_*
# variables as tests/standins/claude. Writes the last message to -o <file>
# and prints JSONL events with token usage, like `codex exec --json`.
set -euo pipefail
if [[ -n "${FI_STANDIN_TRACE:-}" ]]; then
  ( IFS=$'\x1f'; printf 'codex\x1f%s\n' "$*" ) >>"$FI_STANDIN_TRACE"
fi
[[ -n "${FI_STANDIN_SLEEP:-}" ]] && sleep "$FI_STANDIN_SLEEP"
last="" sandbox="" cd_dir="" prev=""
for a in "$@"; do
  case "$prev" in
    -o|--output-last-message) last="$a" ;;
    -s|--sandbox) sandbox="$a" ;;
    -C|--cd) cd_dir="$a" ;;
  esac
  prev="$a"
done
[[ -n "$cd_dir" ]] && cd "$cd_dir"
export FI_STANDIN_PROMPT="${!#}"
FI_STANDIN_NO_TAGS='{"tags":[],"wake":[]}'
# A failed turn exits before any edit or -o write, like the real codex.
if [[ -n "${FI_STANDIN_CODEX_FAIL:-}" && ( "$sandbox" == "$FI_STANDIN_CODEX_FAIL" || "$FI_STANDIN_CODEX_FAIL" == all ) ]]; then
  printf '{"type":"thread.started"}\n'
  msg="${FI_STANDIN_CODEX_FAIL_MSG:-The 'bad-model' model is not supported when using Codex with a ChatGPT account.}"
  inner="$(jq -cn --arg m "$msg" '{type:"error",status:400,error:{type:"invalid_request_error",message:$m}}')"
  jq -cn --arg m "$inner" '{type:"turn.failed",error:{message:$m}}'
  echo 'Reading additional input from stdin...' >&2
  exit 1
fi
if [[ "$FI_STANDIN_PROMPT" == *"found-issues classifier"* ]]; then
  text="${FI_STANDIN_CLASSIFY:-$FI_STANDIN_NO_TAGS}"
elif [[ "$sandbox" == "read-only" ]]; then
  # A verifier that dies without a verdict or a turn.failed event, like a
  # crash, a lost login or the watchdog's TERM.
  [[ -n "${FI_STANDIN_VERIFIER_CRASH:-}" ]] && exit "$FI_STANDIN_VERIFIER_CRASH"
  text='{"approve":true,"reason":"ok"}'
  if [[ -n "${FI_STANDIN_VERDICTS:-}" && -s "$FI_STANDIN_VERDICTS" ]]; then
    IFS= read -r text <"$FI_STANDIN_VERDICTS"
    tail -n +2 "$FI_STANDIN_VERDICTS" >"$FI_STANDIN_VERDICTS.tmp"
    mv "$FI_STANDIN_VERDICTS.tmp" "$FI_STANDIN_VERDICTS"
  fi
else
  [[ -n "${FI_STANDIN_EDIT:-}" ]] && bash -c "$FI_STANDIN_EDIT"
  text="Done."$'\n'"${FI_STANDIN_RESULT:-FI-RESULT: fixed}"
fi
[[ -n "$last" ]] && printf '%s\n' "$text" >"$last"
printf '{"type":"thread.started"}\n'
printf '{"type":"turn.completed","usage":{"input_tokens":%s,"cached_input_tokens":0,"output_tokens":300}}\n' "${FI_STANDIN_TOKENS:-1200}"
# A verifier that answers and still exits non-zero.
[[ "$sandbox" == "read-only" && -n "${FI_STANDIN_VERIFIER_RC:-}" ]] && exit "$FI_STANDIN_VERIFIER_RC"
exit 0
