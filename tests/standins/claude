#!/usr/bin/env bash
# Stand-in `claude` for the v3 auto-fix tests: no network, no cost.
#   FI_STANDIN_TRACE   append one line per call: argv joined by 0x1f
#   FI_STANDIN_EDIT    shell run in cwd by fixer calls (the "fix")
#   FI_STANDIN_RESULT  fixer final line (default "FI-RESULT: fixed")
#   FI_STANDIN_VERDICTS file of verifier JSON verdicts, one per line, popped
#                      in order (default {"approve":true,"reason":"ok"})
#   FI_STANDIN_COST    total_cost_usd per call (default 0.25)
#   FI_STANDIN_SLEEP   seconds to sleep first (watchdog tests)
#   FI_STANDIN_ERROR   act like an outage: is_error result with this text, exit 1
#   FI_STANDIN_CLASSIFY the sweep classifier's JSON reply (default no tags)
#   FI_STANDIN_VERIFIER_CRASH exit code of a verifier that dies with no output
#   FI_STANDIN_FIXER_CRASH    exit code of a fixer that dies with no output
#   FI_STANDIN_VERIFIER_HANG  seconds a verifier sleeps first, to be killed by the watchdog
#   FI_STANDIN_VERIFIER_RC    exit code of a verifier that answers and still exits non-zero
#   FI_STANDIN_VERIFIER_LIMIT result subtype of a verifier that hit a run limit
#                      (error_max_turns, error_max_budget_usd): is_error, no
#                      result text, exit 1 (or FI_STANDIN_VERIFIER_RC)
# FI_STANDIN_EDIT sees the prompt (the last argument) as $FI_STANDIN_PROMPT.
set -euo pipefail
if [[ -n "${FI_STANDIN_TRACE:-}" ]]; then
  ( IFS=$'\x1f'; printf 'claude\x1f%s\n' "$*" ) >>"$FI_STANDIN_TRACE"
fi
[[ -n "${FI_STANDIN_SLEEP:-}" ]] && sleep "$FI_STANDIN_SLEEP"
if [[ -n "${FI_STANDIN_ERROR:-}" ]]; then
  jq -n --arg r "$FI_STANDIN_ERROR" '{type:"result",subtype:"success",is_error:true,result:$r,total_cost_usd:0}'
  exit 1
fi
export FI_STANDIN_PROMPT="${!#}"
FI_STANDIN_NO_TAGS='{"tags":[],"wake":[]}'
if [[ "$FI_STANDIN_PROMPT" == *"found-issues classifier"* ]]; then
  jq -n --arg r "${FI_STANDIN_CLASSIFY:-$FI_STANDIN_NO_TAGS}" --argjson c "${FI_STANDIN_COST:-0.25}" \
    '{type:"result",subtype:"success",is_error:false,result:$r,total_cost_usd:$c,permission_denials:[]}'
  exit 0
fi
verifier=0 prev=""
for a in "$@"; do
  [[ "$prev" == "--model" && "$a" == "opus" ]] && verifier=1
  prev="$a"
done
if (( verifier )); then
  [[ -n "${FI_STANDIN_VERIFIER_HANG:-}" ]] && sleep "$FI_STANDIN_VERIFIER_HANG"
  [[ -n "${FI_STANDIN_VERIFIER_CRASH:-}" ]] && exit "$FI_STANDIN_VERIFIER_CRASH"
  if [[ -n "${FI_STANDIN_VERIFIER_LIMIT:-}" ]]; then
    jq -n --arg s "$FI_STANDIN_VERIFIER_LIMIT" --argjson c "${FI_STANDIN_COST:-0.25}" \
      '{type:"result",subtype:$s,is_error:true,total_cost_usd:$c,permission_denials:[]}'
    exit "${FI_STANDIN_VERIFIER_RC:-1}"
  fi
  text='{"approve":true,"reason":"ok"}'
  if [[ -n "${FI_STANDIN_VERDICTS:-}" && -s "$FI_STANDIN_VERDICTS" ]]; then
    IFS= read -r text <"$FI_STANDIN_VERDICTS"
    tail -n +2 "$FI_STANDIN_VERDICTS" >"$FI_STANDIN_VERDICTS.tmp"
    mv "$FI_STANDIN_VERDICTS.tmp" "$FI_STANDIN_VERDICTS"
  fi
else
  [[ -n "${FI_STANDIN_FIXER_CRASH:-}" ]] && exit "$FI_STANDIN_FIXER_CRASH"
  [[ -n "${FI_STANDIN_EDIT:-}" ]] && bash -c "$FI_STANDIN_EDIT"
  text="Done."$'\n'"${FI_STANDIN_RESULT:-FI-RESULT: fixed}"
fi
jq -n --arg r "$text" --argjson c "${FI_STANDIN_COST:-0.25}" \
  '{type:"result",subtype:"success",is_error:false,result:$r,total_cost_usd:$c,permission_denials:[]}'
(( verifier )) && [[ -n "${FI_STANDIN_VERIFIER_RC:-}" ]] && exit "$FI_STANDIN_VERIFIER_RC"
exit 0
