#!/usr/bin/env bash
# found-issues — markdown-based issue tracker for AI agents
# https://github.com/AltDoug/found-issues
#
# Single binary with subcommands. See `found-issues --help` for usage.
#
# === READ-LOOP GUARD (file-wide convention) ===
#
# Every loop that reads the ledger from a plain redirect MUST be written
#
#   while IFS= read -r line || [[ -n "$line" ]]; do ... done <"$file"
#
# `read` returns non-zero on a FINAL line with no trailing newline, so a plain
# `while read` never runs its body for that line. In a rewrite loop the entry is
# silently DROPPED (v2.2.1: defer, sync, annotate-commit and promote-deferred
# each turned a 2-entry ledger into 1 — sync being the worst case, since
# SessionStart runs it with no user action and no output saying anything was
# removed). In a scan loop the final entry becomes unselectable, which is the
# same input shape misbehaving. Hand-edited ledgers and some editors produce
# exactly this shape. Same data-loss class as the wc -l undercount (v1.6.x).
#
# Loops fed by process substitution (`< <(fi_entries ...)`) or a here-string
# (`<<<"$content"`) are exempt and deliberately left unguarded: awk output and
# bash here-strings are always newline-terminated.
#
# tests/source-guards.bats enforces this by parsing this file — a new unguarded
# file-fed read loop fails CI with its line number.

set -euo pipefail

readonly FI_VERSION="2.3.0"

# Resolve script directory, following symlinks.
fi_script_dir() {
  local source="${BASH_SOURCE[0]}"
  while [[ -h "$source" ]]; do
    local dir
    dir="$( cd -P "$( dirname "$source" )" && pwd )"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd -P "$( dirname "$source" )" && pwd
}

readonly FI_BIN_DIR="$(fi_script_dir)"
# lib/ resolution priority:
#   1. $FOUND_ISSUES_LIB_DIR (explicit override; useful for tests)
#   2. $CLAUDE_PLUGIN_ROOT/lib (when running as a Claude Code plugin)
#   3. $FI_BIN_DIR/../lib (when running from source checkout)
if [[ -n "${FOUND_ISSUES_LIB_DIR:-}" ]]; then
  readonly FI_LIB_DIR="$FOUND_ISSUES_LIB_DIR"
elif [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]]; then
  readonly FI_LIB_DIR="$CLAUDE_PLUGIN_ROOT/lib"
else
  readonly FI_LIB_DIR="$FI_BIN_DIR/../lib"
fi

# Source libraries
# shellcheck source=../lib/canonicalize.sh
source "$FI_LIB_DIR/canonicalize.sh"
# shellcheck source=../lib/parse-entries.sh
source "$FI_LIB_DIR/parse-entries.sh"
# shellcheck source=../lib/detect-mode.sh
source "$FI_LIB_DIR/detect-mode.sh"
# The statusline family lives in lib/ (extracted v2.2.5, tracked §12 split).
# shellcheck source=../lib/statusline-core.sh
source "$FI_LIB_DIR/statusline-core.sh"
# shellcheck source=../lib/statusline-target.sh
source "$FI_LIB_DIR/statusline-target.sh"
# shellcheck source=../lib/statusline-install.sh
source "$FI_LIB_DIR/statusline-install.sh"
# shellcheck source=../lib/statusline-uninstall.sh
source "$FI_LIB_DIR/statusline-uninstall.sh"
# doctor and the install/uninstall maintenance subcommands (extracted v2.2.6).
# shellcheck source=../lib/uninstall.sh
source "$FI_LIB_DIR/uninstall.sh"
# shellcheck source=../lib/archive.sh
source "$FI_LIB_DIR/archive.sh"
# shellcheck source=../lib/doctor.sh
source "$FI_LIB_DIR/doctor.sh"
# shellcheck source=../lib/codex-hooks.sh
source "$FI_LIB_DIR/codex-hooks.sh"
# shellcheck source=../lib/fi-alias.sh
source "$FI_LIB_DIR/fi-alias.sh"
# help and the ledger read/write subcommands (extracted v2.2.7).
# shellcheck source=../lib/help.sh
source "$FI_LIB_DIR/help.sh"
# shellcheck source=../lib/log.sh
source "$FI_LIB_DIR/log.sh"
# shellcheck source=../lib/defer.sh
source "$FI_LIB_DIR/defer.sh"
# shellcheck source=../lib/resolve.sh
source "$FI_LIB_DIR/resolve.sh"
# shellcheck source=../lib/promote-deferred.sh
source "$FI_LIB_DIR/promote-deferred.sh"
# shellcheck source=../lib/list-status.sh
source "$FI_LIB_DIR/list-status.sh"

# the annotate engine, sync and promote (extracted v2.2.9 — the final group).
# shellcheck source=../lib/annotate.sh
source "$FI_LIB_DIR/annotate.sh"
# shellcheck source=../lib/annotate-commands.sh
source "$FI_LIB_DIR/annotate-commands.sh"
# shellcheck source=../lib/sync.sh
source "$FI_LIB_DIR/sync.sh"
# shellcheck source=../lib/promote.sh
source "$FI_LIB_DIR/promote.sh"

# === Utilities ===

fi_today() { date +%Y-%m-%d; }

# Print to stderr.
fi_err() { printf '%s\n' "$@" >&2; }

# Git is the oracle for "this path is really gone" (issue #151, 2026-08-14).
#
# Absence from the filesystem is NOT evidence an issue was fixed. A cited path
# can be absent because it was never a file at all (abstract locations like
# `workflow/release-process`), because it is gitignored, or because someone
# deleted it in a dirty worktree and has not committed. Tombstoning on bare
# absence false-closed live entries in every one of those cases — silently,
# since SessionStart runs sync unattended, and permanently, since no supported
# command reopens a [fixed] entry.
#
# Returns 0 ONLY when git confirms a committed removal: the path is absent from
# the current HEAD tree AND git has history for it. Returns 1 (do not close) for
# every ambiguous case — no repo, no commits, still tracked in HEAD (a
# working-tree-only deletion), or never tracked at all. Failing closed here
# costs a stale [open] entry; failing open costs a permanently lost one.
fi_git_confirms_removed() {
  local path="$1"
  [[ -n "$path" ]] || return 1
  git rev-parse --git-dir >/dev/null 2>&1 || return 1
  git rev-parse --verify HEAD >/dev/null 2>&1 || return 1
  # Present in HEAD => not a committed removal (dirty-worktree deletion).
  if git cat-file -e "HEAD:$path" 2>/dev/null; then
    return 1
  fi
  # Absent from HEAD: only a removal if git ever tracked it.
  [[ -n "$(git log -1 --pretty=format:%H -- "$path" 2>/dev/null)" ]]
}

# Detect if a missing file was renamed via git. Returns the final path on
# stdout if a rename target chain resolves to a file in the working tree;
# returns nothing + exits 1 otherwise.
#
# Lists all rename events repo-wide via `git log --diff-filter=R -M
# --name-status`. Follows the rename chain forward from $old_path until either
# no further rename is found (current target) or the target exists on disk.
# Format per rename line: R<score>\told_path\tnew_path
fi_detect_rename() {
  local old_path="$1"
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    return 1
  fi
  local renames
  renames="$(git log --diff-filter=R -M --name-status --pretty=format: 2>/dev/null \
    | awk -F'\t' '/^R[0-9]+\t/ { print $2 "\t" $3 }')"
  if [[ -z "$renames" ]]; then
    return 1
  fi
  # Follow rename chain: old → new → newer → ...
  # Reverse the list so older renames come first (git log is reverse-chrono).
  local rev_renames
  rev_renames="$(printf '%s\n' "$renames" | awk '{ a[NR]=$0 } END { for(i=NR;i>=1;i--) print a[i] }')"
  local current="$old_path"
  local found=0
  local hops=0
  local line src dst
  # Bound hops to avoid pathological loops (shouldn't happen in git history).
  while (( hops < 100 )); do
    local next=""
    while IFS=$'\t' read -r src dst; do
      if [[ "$src" == "$current" ]]; then
        next="$dst"
      fi
    done <<<"$rev_renames"
    if [[ -z "$next" ]]; then
      break
    fi
    current="$next"
    found=1
    hops=$((hops + 1))
  done
  if (( found == 1 )) && [[ -f "$current" ]]; then
    printf '%s' "$current"
    return 0
  fi
  return 1
}

# Find or create the issues file based on detected mode.
# Echoes the path. Creates parent directory + initial header if missing.
fi_resolve_issues_file() {
  local mode
  mode="$(fi_detect_mode)"

  local target=""
  if [[ "$mode" == "local" ]]; then
    target="$PWD/.found-issues.md"
  else
    local repo_root
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    target="$repo_root/docs/found-issues.md"
  fi

  if [[ ! -f "$target" ]]; then
    mkdir -p "$(dirname "$target")"
    cat >"$target" <<'EOF'
# found-issues

Issues noticed outside the current task scope. Format: `- [status] YYYY-MM-DD path:line — symptom (suggested: fix)`. Statuses: `open`, `deferred`, `fixed`.

Maintained automatically by Claude. See <https://github.com/AltDoug/found-issues> for docs.

EOF
  fi

  printf '%s' "$target"
}

# Get the GitHub repo identifier (org/repo) from the current repo's origin.
# Echoes empty if not on GitHub.
fi_repo_id() {
  local remote_url
  remote_url="$(git remote get-url origin 2>/dev/null || true)"
  if [[ "$remote_url" != *"github.com"* ]]; then
    return 1
  fi
  # Strip trailing slashes, then a literal .git suffix, then capture the
  # last two path segments verbatim. The earlier single-pass form used
  # [^/.]+ for the repo segment, truncating dotted repo names
  # (vercel/next.js -> vercel/next) in (PR: ...) annotations, which then
  # made sync query the wrong repo. The slash strip comes first so
  # pasted-URL remotes like https://github.com/org/repo.git/ still lose
  # the .git suffix.
  printf '%s' "$remote_url" \
    | sed -E 's|/+$||; s|\.git$||; s|.*github\.com[:/]([^/]+/[^/]+).*|\1|'
}

# Resolve the default branch with a layered fallback chain:
#   1. git symbolic-ref refs/remotes/origin/HEAD (primary, fast, no network)
#   2. gh repo view --json defaultBranchRef.name (fallback when origin/HEAD unset)
#   3. literal "main" (last-resort guess)
#
# Caches the gh-result per-repo for 1h to avoid repeated network calls.
# Cache file: ${XDG_CACHE_HOME:-$HOME/.cache}/found-issues/default-branch-<slug>.txt
fi_resolve_default_branch() {
  local default_branch

  # Primary: origin/HEAD symref
  default_branch="$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's|^refs/remotes/origin/||' || true)"
  if [[ -n "$default_branch" ]]; then
    printf '%s' "$default_branch"
    return 0
  fi

  # Fallback: gh repo view, with cache
  local repo_slug
  repo_slug="$(fi_repo_id 2>/dev/null || true)"
  if [[ -n "$repo_slug" ]] && command -v gh >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/found-issues"
    local cache_file="$cache_dir/default-branch-${repo_slug//\//-}.txt"
    mkdir -p "$cache_dir" 2>/dev/null || true

    # Check cache freshness (1h TTL). fi_file_mtime is the cross-platform
    # mtime helper (see lib/detect-mode.sh) — guarantees a numeric result
    # so `$(( now - mtime ))` is safe under `set -u`.
    if [[ -f "$cache_file" ]]; then
      local mtime now age
      mtime="$(fi_file_mtime "$cache_file")"
      now="$(date +%s)"
      age=$((now - mtime))
      if (( age < 3600 )); then
        local cached
        cached="$(cat "$cache_file" 2>/dev/null)"
        if [[ -n "$cached" ]]; then
          printf '%s' "$cached"
          return 0
        fi
      fi
    fi

    # Fetch fresh
    local gh_result
    gh_result="$(gh repo view --json defaultBranchRef 2>/dev/null \
      | jq -r '.defaultBranchRef.name // empty' 2>/dev/null || true)"
    if [[ -n "$gh_result" ]]; then
      printf '%s' "$gh_result" > "$cache_file"
      printf '%s' "$gh_result"
      return 0
    fi
  fi

  # Last resort
  printf 'main'
  return 0
}

# === Main dispatch ===

main() {
  if [[ $# -eq 0 ]]; then
    cmd_help
    return 0
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    log)              cmd_log "$@" ;;
    sync)             cmd_sync "$@" ;;
    list)             cmd_list "$@" ;;
    status)
      local format="segment" cwd=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --format=*) format="${1#--format=}"; shift ;;
          --format)   format="${2:-segment}"; shift 2 ;;
          --cwd=*)    cwd="${1#--cwd=}"; shift ;;
          --cwd)      cwd="${2:-}"; shift 2 ;;
          -h|--help)  cmd_help; return 0 ;;
          *)          shift ;;
        esac
      done
      cmd_status "$format" "$cwd"
      ;;
    annotate-pr)      cmd_annotate_pr "$@" ;;
    annotate-commit)  cmd_annotate_commit "$@" ;;
    defer)            cmd_defer "$@" ;;
    promote-deferred)     cmd_promote_deferred "$@" ;;
    resolve)          cmd_resolve "$@" ;;
    promote)          cmd_promote "$@" ;;
    install-statusline)   cmd_install_statusline "$@" ;;
    uninstall-statusline) cmd_uninstall_statusline "$@" ;;
    doctor-statusline)            cmd_doctor_statusline "$@" ;;
    doctor-statusline-runtime)    cmd_doctor_statusline_runtime "$@" ;;
    doctor)               cmd_doctor "$@" ;;
    install-fi-alias)     cmd_install_fi_alias "$@" ;;
    uninstall-fi-alias)   cmd_uninstall_fi_alias "$@" ;;
    install-codex-hooks)   cmd_install_codex_hooks "$@" ;;
    uninstall-codex-hooks) cmd_uninstall_codex_hooks "$@" ;;
    uninstall)            cmd_uninstall "$@" ;;
    archive)              cmd_archive "$@" ;;
    -v|--version)     cmd_version ;;
    -h|--help|help)   cmd_help ;;
    *)
      fi_err "Unknown command: $cmd"
      cmd_help >&2
      return 1
      ;;
  esac
}

# Dispatch only when executed directly. Sourcing the script (e.g. a unit test
# exercising an internal function such as fi_diff_old_ranges) loads the
# function definitions without running the CLI.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
